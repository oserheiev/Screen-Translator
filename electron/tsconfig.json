{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "outDir": "../build/electron",
    "baseUrl": ".",
    "paths": {
      "*": ["../node_modules/*"]
    },
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "**/*"
  ]
}