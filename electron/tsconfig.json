{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "../build",
    "baseUrl": ".",
    "paths": {
      "*": ["../node_modules/*"]
    },
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "**/*",
    "../src/i18n/index.ts",
    "../src/i18n/locales/**/*",
    "../src/types/**/*"
  ]
}