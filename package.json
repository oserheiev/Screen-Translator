{
  "name": "screen-translator",
  "version": "1.8.0",
  "description": "A desktop application that allows you to capture text from any of your screens and translate it between multiple languages",
  "main": "build/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "webpack --config webpack.config.js && tsc -p electron/tsconfig.json",
    "build:renderer": "webpack --config webpack.config.js",
    "build:main": "tsc -p electron/tsconfig.json",
    "watch": "webpack --config webpack.config.js --watch",
    "dev": "concurrently \"npm run watch\" \"electron .\"",
    "package": "electron-builder build --mac --win",
    "package:mac": "electron-builder build --mac",
    "package:win": "electron-builder build --win",
    "release": "npm run build && electron-builder --publish always",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "electron-rebuild"
  },
  "keywords": [
    "electron",
    "screen",
    "translator",
    "ocr",
    "gemini"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^0.13.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "markdown-to-jsx": "^9.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/electron": "^1.6.12",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "39.7.0",
    "electron-builder": "^24.13.0",
    "html-webpack-plugin": "^5.6.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "js-yaml": "^5.2.1",
    "process": "^0.11.10",
    "style-loader": "^3.3.4",
    "ts-jest": "29.4.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.screentranslator.app",
    "productName": "Screen Translator",
    "icon": "assets/icons/icon.png",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icons/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.png",
      "artifactName": "Screen-Translator-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "**/uiohook-napi/**"
    ],
    "files": [
      "build/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "build/electron/main.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "owner": "oserheiev",
      "repo": "Screen-Translator"
    }
  }
}
